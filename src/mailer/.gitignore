# Package resolution generated by `dart pub get`. Machine-specific: it hardcodes
# absolute .pub-cache paths, so it is useless on any other machine.
.dart_tool/

# `dart compile exe` output. The Dockerfile writes bin/server; keep the source.
build/
bin/server

# Note: pubspec.lock IS tracked. This is an application, not a library, so the
# exact resolved versions are part of what gets deployed.
