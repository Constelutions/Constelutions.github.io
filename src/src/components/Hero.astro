---

---

<section class="hero">
  <div
    class="starfield"
    data-stars="60">
  </div>
  <div class="wrap hero-grid">
    <div class="hero-left">
      <span
        class="eyebrow"
        data-i18n="hero_eyebrow"
        >Desarrollo · Diseño · Integración</span
      >
      <h1 data-i18n-html="hero_head">Cada solución, una <em>constelación</em> de talento.</h1>
      <p
        class="lede"
        data-i18n="hero_lede">
        Conectamos ingeniería, diseño y estrategia para construir productos digitales que escalan.
        Un solo equipo, alineado a tus objetivos.
      </p>
      <div class="hero-cta">
        <a
          href="#contacto"
          class="btn btn-primary btn-lg"
          data-i18n="cta_start"
          >Iniciar proyecto</a
        >
        <a
          href="/services"
          class="btn btn-ghost btn-lg"
          data-i18n="cta_services"
          >Ver servicios</a
        >
      </div>
      <div class="hero-chips">
        <span class="chip">Software Development</span>
        <span class="chip">UI/UX Design</span>
        <span class="chip">API Integration</span>
        <span class="chip">DevOps</span>
        <span class="chip">Cyber Security</span>
        <span class="chip">Cloud Architecture</span>
      </div>
    </div>
    <div class="hero-canvas-wrap">
      <canvas data-constellation></canvas>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 76px;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-grid {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 40px;
    align-items: center;
    min-height: calc(100vh - 76px);
    padding: 40px 0 60px;
  }
  .hero h1 {
    font-size: clamp(40px, 5.4vw, 70px);
    margin: 24px 0 26px;
  }
  .hero .lede {
    max-width: 500px;
  }
  .hero-cta {
    display: flex;
    gap: 14px;
    margin-top: 38px;
    flex-wrap: wrap;
  }
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 46px;
    max-width: 540px;
  }
  .chip {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 13px;
    background: oklch(0.2 0.03 264 / 0.4);
  }
  .hero-canvas-wrap {
    position: relative;
    height: 100%;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-canvas-wrap canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 30px;
    }
    .hero-canvas-wrap {
      min-height: 340px;
      order: -1;
    }
  }
</style>
