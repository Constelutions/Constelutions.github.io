---
import { getProjects } from "../repositories/projectsRepository";

const projects = await getProjects();
---

<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <span
        class="eyebrow"
        data-i18n="proj_eyebrow"
        >Proyectos destacados</span
      >
      <h2
        class="section-h"
        data-i18n="proj_title">
        Lo que hemos construido
      </h2>
      <p
        class="lede"
        data-i18n="proj_lede">
        Sistemas en producción que procesan transacciones reales, sirven a usuarios reales y generan
        resultados medibles para nuestros clientes.
      </p>
    </div>

    {
      projects.map((p) => (
        <article class={`proj reveal${p.flip ? " flip" : ""}`}>
          <div class="proj-visual">
            <div class="proj-img">
              <span class="proj-num">{p.num}</span>
              <span
                class="photo-label"
                data-i18n="proj_screenshot">
                Captura de pantalla
              </span>
            </div>
            <div class="proj-tags">
              {p.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
          <div class="proj-info">
            <span
              class="industry-badge"
              data-i18n={p.industry_i18n}>
              {p.industry}
            </span>
            <h3 data-i18n={p.title_i18n}>{p.title}</h3>
            <p data-i18n={p.desc_i18n}>{p.desc}</p>
            <div class="proj-outcome">
              <svg viewBox="0 0 24 24">
                <path d="M3 17l4-8 4 4 4-6 4 9" />
              </svg>
              <span data-i18n={p.outcome_i18n}>{p.outcome}</span>
            </div>
          </div>
        </article>
      ))
    }

    <p
      class="placeholder-note"
      data-i18n="proj_note">
      Proyectos representativos — los nombres de clientes se omiten por confidencialidad.
    </p>
  </div>
</section>

<style>
  .proj {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    padding: 56px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .proj:last-of-type {
    border-bottom: 0;
  }
  .proj.flip {
    direction: rtl;
  }
  .proj.flip > * {
    direction: ltr;
  }

  .proj-visual {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .proj-img {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-2);
    background-image: repeating-linear-gradient(
      135deg,
      oklch(0.2 0.03 264) 0 14px,
      oklch(0.18 0.03 264) 14px 28px
    );
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
  }
  .proj-num {
    position: absolute;
    top: 16px;
    left: 20px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent-ink);
    letter-spacing: 0.12em;
  }
  .photo-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--faint);
    letter-spacing: 0.08em;
  }
  .proj-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent-2);
    background: oklch(0.28 0.06 266 / 0.45);
    border: 1px solid oklch(0.4 0.08 266 / 0.5);
    border-radius: 6px;
    padding: 4px 10px;
    letter-spacing: 0.03em;
  }

  .proj-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .industry-badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-ink);
    border: 1px solid oklch(0.5 0.16 266 / 0.4);
    border-radius: 999px;
    padding: 4px 12px;
    width: fit-content;
  }
  .proj-info h3 {
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.15;
  }
  .proj-info p {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.68;
    margin: 0;
  }
  .proj-outcome {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 16px 20px;
    background: oklch(0.28 0.06 266 / 0.25);
    border: 1px solid oklch(0.4 0.1 266 / 0.4);
    border-radius: var(--radius-sm);
  }
  .proj-outcome svg {
    width: 18px;
    height: 18px;
    stroke: var(--ok);
    fill: none;
    stroke-width: 2;
    flex: 0 0 auto;
    margin-top: 2px;
  }
  .proj-outcome span {
    font-size: 14.5px;
    color: var(--ok);
    font-weight: 500;
    line-height: 1.45;
  }

  .placeholder-note {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--faint);
    letter-spacing: 0.04em;
    margin-top: 40px;
    text-align: center;
  }

  @media (max-width: 1040px) {
    .proj,
    .proj.flip {
      grid-template-columns: 1fr;
      gap: 32px;
      direction: ltr;
    }
    .proj.flip > * {
      direction: ltr;
    }
  }
</style>
