---
import { getServices } from "../repositories/servicesRepository";

const services = await getServices();
---

<section
  class="section"
  id="servicios">
  <div class="wrap">
    <div class="section-head reveal">
      <span
        class="eyebrow"
        data-i18n="svc_eyebrow">
        ¿Qué hacemos?
      </span>
      <h2
        class="section-h"
        data-i18n="svc_title">
        Servicios que cubren todo el ciclo de tu producto
      </h2>
      <p
        class="lede"
        data-i18n="svc_lede">
        Desde la primera línea de código hasta la operación en producción, te acompañamos en cada
        etapa.
      </p>
    </div>
    <div class="svc-grid">
      {
        services.map((svc) => (
          <a
            href="/services"
            class="svc-card reveal">
            <span class="svc-num">{svc.num}</span>
            <div class="svc-icon">
              {svc.id === "desarrollo" && (
                <svg viewBox="0 0 24 24">
                  <path d="M8 7l-5 5 5 5" />
                  <path d="M16 7l5 5-5 5" />
                  <path d="M13 4l-2 16" />
                </svg>
              )}
              {svc.id === "diseno" && (
                <svg viewBox="0 0 24 24">
                  <rect
                    x="3"
                    y="4"
                    width="18"
                    height="16"
                    rx="2"
                  />
                  <path d="M3 9h18" />
                  <path d="M9 9v11" />
                </svg>
              )}
              {svc.id === "integraciones" && (
                <svg viewBox="0 0 24 24">
                  <circle
                    cx="5"
                    cy="6"
                    r="2.2"
                  />
                  <circle
                    cx="19"
                    cy="9"
                    r="2.2"
                  />
                  <circle
                    cx="11"
                    cy="18"
                    r="2.2"
                  />
                  <path d="M6.8 7.2 17.2 8M6.4 7.8 9.6 16M17.6 10.6 12.4 16.4" />
                </svg>
              )}
              {svc.id === "consultoria" && (
                <svg viewBox="0 0 24 24">
                  <circle
                    cx="12"
                    cy="12"
                    r="8.5"
                  />
                  <circle
                    cx="12"
                    cy="12"
                    r="3.5"
                  />
                  <path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3" />
                </svg>
              )}
            </div>
            <h3 data-i18n={svc.title_i18n}>{svc.title}</h3>
            <p data-i18n={svc.desc_i18n}>{svc.desc}</p>
            <span class="svc-more">
              <span data-i18n="svc_more">Conocer más</span> →
            </span>
          </a>
        ))
      }
    </div>
    <div class="svc-footer reveal">
      <a
        href="/services"
        class="btn btn-ghost"
        data-i18n="svc_all"
        >Ver todos los servicios</a
      >
    </div>
  </div>
</section>

<style>
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .svc-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 34px 32px;
    transition: all 0.22s;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .svc-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px transparent;
    transition: box-shadow 0.22s;
    pointer-events: none;
  }
  .svc-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    background: var(--surface-2);
  }
  .svc-icon {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: oklch(0.28 0.06 266);
    border: 1px solid var(--line);
    margin-bottom: 22px;
  }
  .svc-icon svg {
    width: 24px;
    height: 24px;
    stroke: var(--accent-2);
    fill: none;
    stroke-width: 1.6;
  }
  .svc-card h3 {
    font-size: 22px;
    margin-bottom: 12px;
  }
  .svc-card p {
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.58;
    margin: 0;
  }
  .svc-num {
    position: absolute;
    top: 28px;
    right: 30px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
    letter-spacing: 0.08em;
  }
  .svc-more {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 20px;
    font-size: 14px;
    color: var(--accent-2);
    font-family: var(--mono);
    letter-spacing: 0.04em;
  }

  .svc-footer {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  @media (max-width: 1040px) {
    .svc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
