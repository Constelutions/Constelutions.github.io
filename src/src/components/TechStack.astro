---
const tech: { category: string; "data-i18n": string; items: string[] }[] = [
  {
    category: "Frontend",
    "data-i18n": "tech_frontend",
    items: ["React", "Next.js", "Vue", "Svelte", "Angular"],
  },
  {
    category: "Backend",
    "data-i18n": "tech_backend",
    items: ["Node.js", "Python", "Go", ".NET", "Java"],
  },
  {
    category: "Móvil",
    "data-i18n": "tech_mobile",
    items: ["Android & iOS", "Flutter", "React Native", ".NET MAUI", "GraphQL"],
  },
  {
    category: "Cloud & DevOps",
    "data-i18n": "tech_cloud",
    items: ["AWS", "Azure", "Kubernetes", "GCP", "Terraform"],
  },
  {
    category: "Base de datos",
    "data-i18n": "tech_database",
    items: ["PostgreSQL", "Microsoft SQL Server", "My SQL", "MongoDB", "Redis"],
  },
];
---

<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <span
        class="eyebrow"
        data-i18n="tech_eyebrow">
        Stack tecnológico
      </span>
      <h2
        class="section-h"
        data-i18n="tech_title">
        Herramientas modernas, elegidas con criterio
      </h2>
      <p
        class="lede"
        data-i18n="tech_lede">
        Seleccionamos cada tecnología según las necesidades del proyecto, no por moda.
      </p>
    </div>
    <div class="tech-cols reveal">
      {
        tech.map((t) => (
          <div class="tech-col">
            <h4 data-i18n={t["data-i18n"]}>{t.category}</h4>
            <ul>
              {t.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tech-cols {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 22px;
  }
  .tech-col h4 {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-2);
    margin-bottom: 18px;
  }
  .tech-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 11px;
  }
  .tech-col li {
    font-size: 15.5px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tech-col li::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex: 0 0 auto;
  }

  @media (max-width: 1040px) {
    .tech-cols {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }
</style>
