---
import { getServiceById } from "../repositories/servicesRepository";

const consulting = await getServiceById("consulting");
const specialties = consulting?.features ?? [];
---

<section
  class="section alt"
  id="specialties">
  <div class="wrap">
    <div class="section-head reveal">
      <span
        class="eyebrow"
        data-i18n="spec_eyebrow"
        >Consultoría especializada</span
      >
      <h2
        class="section-h"
        data-i18n="spec_title">
        Ocho disciplinas para fortalecer tu operación técnica
      </h2>
      <p
        class="lede"
        data-i18n="spec_lede">
        Extiende tu equipo con expertos donde más lo necesitas — por proyecto o de forma continua.
      </p>
    </div>
    <div class="spec-grid reveal">
      {
        specialties.map((s, i) => (
          <div class="spec">
            <span class="sn">{String(i + 1).padStart(2, "0")}</span>
            <h4 data-i18n={s.title_i18n}>{s.title}</h4>
            <p data-i18n={s.desc_i18n}>{s.desc}</p>
          </div>
        ))
      }
    </div>
    <div class="spec-footer reveal">
      <a
        href="/services#consulting"
        class="btn btn-ghost"
        data-i18n="spec_all"
        >Ver todas las consultorías</a
      >
    </div>
  </div>
</section>

<style>
  .spec-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .spec {
    background: var(--bg);
    padding: 30px 26px;
    transition: background 0.2s;
    position: relative;
  }
  :global(.section.alt) .spec {
    background: var(--bg-2);
  }
  .spec:hover {
    background: var(--surface);
  }
  .spec .sn {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 0.1em;
  }
  .spec h4 {
    font-size: 18px;
    margin: 14px 0 9px;
  }
  .spec p {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.5;
    margin: 0;
  }

  .spec-footer {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  @media (max-width: 1040px) {
    .spec-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .spec-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
