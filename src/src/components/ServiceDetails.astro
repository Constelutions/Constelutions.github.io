---
import { getServices } from "../repositories/servicesRepository";

const services = await getServices();
---

<section
  class="section"
  style="padding-top:40px">
  <div class="wrap">
    {
      services.map((svc) => (
        <div
          class="svc-detail reveal"
          id={svc.id}>
          <div class="sd-left">
            <span class="eyebrow">
              {svc.num} — <span data-i18n={svc.title_i18n}>{svc.title}</span>
            </span>
            <div class="sd-icon">
              {svc.id === "development" && (
                <svg viewBox="0 0 24 24">
                  <path d="M8 7l-5 5 5 5" />
                  <path d="M16 7l5 5-5 5" />
                  <path d="M13 4l-2 16" />
                </svg>
              )}
              {svc.id === "design" && (
                <svg viewBox="0 0 24 24">
                  <rect
                    x="3"
                    y="4"
                    width="18"
                    height="16"
                    rx="2"
                  />
                  <path d="M3 9h18" />
                  <path d="M9 9v11" />
                </svg>
              )}
              {svc.id === "integrations" && (
                <svg viewBox="0 0 24 24">
                  <circle
                    cx="5"
                    cy="6"
                    r="2.2"
                  />
                  <circle
                    cx="19"
                    cy="9"
                    r="2.2"
                  />
                  <circle
                    cx="11"
                    cy="18"
                    r="2.2"
                  />
                  <path d="M6.8 7.2 17.2 8M6.4 7.8 9.6 16M17.6 10.6 12.4 16.4" />
                </svg>
              )}
              {svc.id === "consulting" && (
                <svg viewBox="0 0 24 24">
                  <circle
                    cx="12"
                    cy="12"
                    r="8.5"
                  />
                  <circle
                    cx="12"
                    cy="12"
                    r="3.5"
                  />
                  <path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3" />
                </svg>
              )}
            </div>
            {/* h2, not h3: these are the top-level sections of the services
                 page, sitting directly under its <h1> with no h2 between. */}
            <h2 data-i18n={svc.title_i18n}>{svc.title}</h2>
            <p data-i18n={svc.desc_i18n}>{svc.desc}</p>
          </div>
          <div class="feature-list">
            {svc.features.map((f) => (
              <div class="feature">
                <svg viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" />
                </svg>
                <div class="ft">
                  <b data-i18n={f.title_i18n}>{f.title}</b>
                  <span data-i18n={f.desc_i18n}>{f.desc}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
