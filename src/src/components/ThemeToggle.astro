---

---

<!-- Desktop: pill with dark / light buttons -->
<div
  class="themetoggle"
  role="group"
  aria-label="Tema / Theme">
  <button
    type="button"
    data-set-theme="dark"
    data-theme-opt="dark"
    aria-label="Modo oscuro">
    <!-- Moon icon -->
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
    </svg>
  </button>
  <button
    type="button"
    data-set-theme="light"
    data-theme-opt="light"
    aria-label="Modo claro">
    <!-- Sun icon -->
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true">
      <circle
        cx="12"
        cy="12"
        r="4.5"
      ></circle>
      <line
        x1="12"
        y1="2"
        x2="12"
        y2="5"
      ></line>
      <line
        x1="12"
        y1="19"
        x2="12"
        y2="22"
      ></line>
      <line
        x1="2"
        y1="12"
        x2="5"
        y2="12"
      ></line>
      <line
        x1="19"
        y1="12"
        x2="22"
        y2="12"
      ></line>
      <line
        x1="4.93"
        y1="4.93"
        x2="7.05"
        y2="7.05"
      ></line>
      <line
        x1="16.95"
        y1="16.95"
        x2="19.07"
        y2="19.07"
      ></line>
      <line
        x1="19.07"
        y1="4.93"
        x2="16.95"
        y2="7.05"
      ></line>
      <line
        x1="7.05"
        y1="16.95"
        x2="4.93"
        y2="19.07"
      ></line>
    </svg>
  </button>
</div>

<!-- Mobile: single icon-button that shows the current theme icon and cycles on click -->
<button
  class="toggle-mobile theme-toggle-mobile"
  type="button"
  data-theme-mobile
  aria-label="Cambiar tema">
  <!-- Moon (shown when dark is active) -->
  <svg
    data-theme-mobile-icon="dark"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
  </svg>
  <!-- Sun (shown when light is active) -->
  <svg
    data-theme-mobile-icon="light"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    aria-hidden="true">
    <circle
      cx="12"
      cy="12"
      r="4.5"
    ></circle>
    <line
      x1="12"
      y1="2"
      x2="12"
      y2="5"
    ></line>
    <line
      x1="12"
      y1="19"
      x2="12"
      y2="22"
    ></line>
    <line
      x1="2"
      y1="12"
      x2="5"
      y2="12"
    ></line>
    <line
      x1="19"
      y1="12"
      x2="22"
      y2="12"
    ></line>
    <line
      x1="4.93"
      y1="4.93"
      x2="7.05"
      y2="7.05"
    ></line>
    <line
      x1="16.95"
      y1="16.95"
      x2="19.07"
      y2="19.07"
    ></line>
    <line
      x1="19.07"
      y1="4.93"
      x2="16.95"
      y2="7.05"
    ></line>
    <line
      x1="7.05"
      y1="16.95"
      x2="4.93"
      y2="19.07"
    ></line>
  </svg>
</button>

<style>
  /* Mobile button hidden on desktop */
  .theme-toggle-mobile {
    display: none;
  }

  @media (max-width: 860px) {
    /* Hide desktop pill */
    .themetoggle {
      display: none;
    }
    /* Show mobile button */
    .theme-toggle-mobile {
      display: inline-flex;
    }
    /* Show only the icon for the active theme */
    [data-theme-mobile-icon] {
      display: none;
    }
    html[data-theme="dark"] [data-theme-mobile-icon="dark"],
    html[data-theme="light"] [data-theme-mobile-icon="light"] {
      display: block;
    }
  }
</style>

<script>
  (function () {
    const btn = document.querySelector<HTMLButtonElement>("[data-theme-mobile]");
    if (!btn) return;

    btn.addEventListener("click", function () {
      const current = document.documentElement.getAttribute("data-theme") ?? "dark";
      const next = current === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      try {
        localStorage.setItem("cl_theme", next);
      } catch (_e) {}
    });
  })();
</script>
