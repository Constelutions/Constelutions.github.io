<section class="section">
  <div class="wrap">
    <div class="cta-banner reveal">
      <div class="glow"></div>
      <div
        class="starfield"
        data-stars="30">
      </div>
      <h2 data-i18n="cta_title">¿Listo para construir algo extraordinario?</h2>
      <p
        class="lede"
        data-i18n="cta_lede">
        Agenda una consulta gratuita y descubre cómo podemos ayudarte.
      </p>
      <div class="cta-buttons">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 64px;
    text-align: center;
    overflow: hidden;
    background: var(--surface);
    isolation: isolate;
  }
  .cta-banner .glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(circle at 50% 120%, var(--accent-dim) 0%, transparent 60%);
  }
  .cta-banner > * {
    position: relative;
    z-index: 2;
  }
  .cta-banner h2 {
    font-size: clamp(28px, 3.6vw, 42px);
    margin-bottom: 18px;
  }
  .cta-banner p {
    max-width: 540px;
    margin: 0 auto 30px;
  }
  .cta-buttons {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 600px) {
    .cta-banner {
      padding: 40px 24px;
    }
  }
</style>
