---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Servicios — Constelutions"
  description="Servicios de Constelutions: Desarrollo de Software, Diseño UI/UX, Integración de APIs y Sistemas, y Consultoría técnica especializada.">
  <Header activePage="services" />

  <!-- ============ PAGE HEAD ============ -->
  <section class="page-head">
    <div class="glow"></div>
    <div
      class="starfield"
      data-stars="50">
    </div>
    <div class="wrap">
      <div class="inner">
        <div class="breadcrumb">
          <a
            href="/"
            data-i18n="nav_home"
            >Inicio</a
          > / <span data-i18n="sp_eyebrow">Servicios</span>
        </div>
        <span
          class="eyebrow"
          data-i18n="sp_eyebrow"
          >Servicios</span
        >
        <h1 data-i18n="sp_title">Capacidades completas para construir, integrar y escalar.</h1>
        <p
          class="lede"
          data-i18n="sp_lede">
          Cuatro servicios principales y ocho especialidades de consultoría, diseñados para empresas
          y equipos técnicos.
        </p>
        <div class="hero-cta">
          <a
            href="/#contacto"
            class="btn btn-primary btn-lg"
            data-i18n="cta_start"
            >Iniciar proyecto</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SERVICE DETAILS ============ -->
  <section
    class="section"
    style="padding-top:40px">
    <div class="wrap">
      <!-- 01 Software Development -->
      <div
        class="svc-detail reveal"
        id="desarrollo">
        <div class="sd-left">
          <span class="eyebrow">01 — <span data-i18n="svc1_t">Desarrollo de Software</span></span>
          <div class="sd-icon">
            <svg viewBox="0 0 24 24"
              ><path d="M8 7l-5 5 5 5"></path><path d="M16 7l5 5-5 5"></path><path d="M13 4l-2 16"
              ></path></svg
            >
          </div>
          <h3 data-i18n="svc1_t">Desarrollo de Software</h3>
          <p data-i18n="sd1_desc">
            Construimos aplicaciones web y móviles a la medida de tu negocio, con arquitectura
            sólida y código mantenible que crece contigo.
          </p>
        </div>
        <div class="feature-list">
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sd1_f1_t">Aplicaciones web</b><span data-i18n="sd1_f1_d"
                >SPA, dashboards y plataformas con React, Next.js y más.</span
              >
            </div>
          </div>
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sd1_f2_t">Apps móviles</b><span data-i18n="sd1_f2_d"
                >iOS y Android, nativo o multiplataforma.</span
              >
            </div>
          </div>
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sd1_f3_t">Backend &amp; APIs</b><span data-i18n="sd1_f3_d"
                >Servicios escalables, seguros y bien documentados.</span
              >
            </div>
          </div>
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sd1_f4_t">Modernización</b><span data-i18n="sd1_f4_d"
                >Migración y refactor de sistemas heredados.</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- 02 UI/UX -->
      <div
        class="svc-detail reveal"
        id="diseno">
        <div class="sd-left">
          <span class="eyebrow">02 — <span data-i18n="svc2_t">Diseño UI/UX</span></span>
          <div class="sd-icon">
            <svg viewBox="0 0 24 24"
              ><rect
                x="3"
                y="4"
                width="18"
                height="16"
                rx="2"
              ></rect><path d="M3 9h18"></path><path d="M9 9v11"></path></svg
            >
          </div>
          <h3 data-i18n="svc2_t">Diseño UI/UX</h3>
          <p data-i18n="sd2_desc">
            Diseñamos experiencias digitales claras y atractivas, centradas en tus usuarios y en los
            objetivos de tu negocio.
          </p>
        </div>
        <div class="feature-list">
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sd2_f1_t">Investigación UX</b><span data-i18n="sd2_f1_d"
                >Entrevistas, flujos y arquitectura de información.</span
              >
            </div>
          </div>
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sd2_f2_t">Diseño de interfaz</b><span data-i18n="sd2_f2_d"
                >Sistemas de diseño consistentes y accesibles.</span
              >
            </div>
          </div>
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sd2_f3_t">Prototipado</b><span data-i18n="sd2_f3_d"
                >Prototipos interactivos para validar antes de construir.</span
              >
            </div>
          </div>
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sd2_f4_t">Pruebas de usabilidad</b><span data-i18n="sd2_f4_d"
                >Validación con usuarios reales e iteración.</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- 03 API & System Integrations -->
      <div
        class="svc-detail reveal"
        id="integraciones">
        <div class="sd-left">
          <span class="eyebrow"
            >03 — <span data-i18n="svc3_t">Integración de APIs y Sistemas</span></span
          >
          <div class="sd-icon">
            <svg viewBox="0 0 24 24"
              ><circle
                cx="5"
                cy="6"
                r="2.2"
              ></circle><circle
                cx="19"
                cy="9"
                r="2.2"
              ></circle><circle
                cx="11"
                cy="18"
                r="2.2"
              ></circle><path d="M6.8 7.2 17.2 8M6.4 7.8 9.6 16M17.6 10.6 12.4 16.4"></path></svg
            >
          </div>
          <h3 data-i18n="svc3_t">Integración de APIs y Sistemas</h3>
          <p data-i18n="sd3_desc">
            Conectamos tus herramientas, servicios y fuentes de datos para que tu operación funcione
            como un sistema unificado.
          </p>
        </div>
        <div class="feature-list">
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sd3_f1_t">Integración de APIs</b><span data-i18n="sd3_f1_d"
                >REST, GraphQL y webhooks entre plataformas.</span
              >
            </div>
          </div>
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sd3_f2_t">Sincronización de datos</b><span data-i18n="sd3_f2_d"
                >Flujos confiables entre sistemas y bases de datos.</span
              >
            </div>
          </div>
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sd3_f3_t">Servicios externos</b><span data-i18n="sd3_f3_d"
                >Pagos, ERP, CRM y servicios de terceros.</span
              >
            </div>
          </div>
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sd3_f4_t">Automatización</b><span data-i18n="sd3_f4_d"
                >Procesos automatizados que ahorran tiempo.</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- 04 Consulting -->
      <div
        class="svc-detail reveal"
        id="consultoria">
        <div class="sd-left">
          <span class="eyebrow">04 — <span data-i18n="svc4_t">Servicios de Consultoría</span></span>
          <div class="sd-icon">
            <svg viewBox="0 0 24 24"
              ><circle
                cx="12"
                cy="12"
                r="8.5"
              ></circle><circle
                cx="12"
                cy="12"
                r="3.5"
              ></circle><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3"></path></svg
            >
          </div>
          <h3 data-i18n="svc4_t">Servicios de Consultoría</h3>
          <p data-i18n="sd4_desc">
            Ponemos a tu disposición especialistas que elevan el estándar técnico de tu equipo, por
            proyecto o de forma continua. Estas son nuestras ocho áreas de consultoría:
          </p>
        </div>
        <div class="feature-list">
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sp1_t">Arquitectura</b><span data-i18n="sp1_d"
                >Diseño de sistemas escalables, resilientes y mantenibles.</span
              >
            </div>
          </div>
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sp2_t">Automatización</b><span data-i18n="sp2_d"
                >CI/CD, IaC y flujos que eliminan el trabajo manual.</span
              >
            </div>
          </div>
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sp3_t">Revisión de Código</b><span data-i18n="sp3_d"
                >Evaluación experta para elevar calidad y consistencia.</span
              >
            </div>
          </div>
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sp4_t">Ciberseguridad</b><span data-i18n="sp4_d"
                >Auditorías, buenas prácticas y protección de datos.</span
              >
            </div>
          </div>
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sp5_t">Bases de Datos</b><span data-i18n="sp5_d"
                >Modelado, optimización y alta disponibilidad.</span
              >
            </div>
          </div>
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sp6_t">DevOps</b><span data-i18n="sp6_d"
                >Entrega continua y operación confiable en la nube.</span
              >
            </div>
          </div>
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sp7_t">Observabilidad</b><span data-i18n="sp7_d"
                >Métricas, logs y trazas para ver todo tu sistema.</span
              >
            </div>
          </div>
          <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg><div class="ft">
              <b data-i18n="sp8_t">Rendimiento</b><span data-i18n="sp8_d"
                >Diagnóstico y tuning para sistemas rápidos y eficientes.</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA BANNER ============ -->
  <section
    class="section"
    style="padding-top:0">
    <div class="wrap">
      <div class="cta-banner reveal">
        <div class="glow"></div>
        <div
          class="starfield"
          data-stars="30">
        </div>
        <h2 data-i18n="cta_title">¿Listo para construir algo extraordinario?</h2>
        <p
          class="lede"
          data-i18n="cta_lede">
          Agenda una consulta gratuita y descubre cómo podemos ayudarte.
        </p>
        <div class="hero-cta">
          <a
            href="/#contacto"
            class="btn btn-primary btn-lg"
            data-i18n="cta_book"
            >Agenda una consulta</a
          >
          <a
            href="/"
            class="btn btn-ghost btn-lg"
            data-i18n="nav_home"
            >Inicio</a
          >
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
