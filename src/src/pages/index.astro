---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Constelutions — Soluciones de software a la medida">
  <Header activePage="home" />

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="starfield" data-stars="60"></div>
    <div class="wrap hero-grid">
      <div class="hero-left">
        <span class="eyebrow" data-i18n="hero_eyebrow">Desarrollo · Diseño · Integración</span>
        <h1 data-i18n-html="hero_head">Cada solución, una <em>constelación</em> de talento.</h1>
        <p class="lede" data-i18n="hero_lede">Conectamos ingeniería, diseño y estrategia para construir productos digitales que escalan. Un solo equipo, alineado a tus objetivos.</p>
        <div class="hero-cta">
          <a href="#contacto" class="btn btn-primary btn-lg" data-i18n="cta_start">Iniciar proyecto</a>
          <a href="/servicios" class="btn btn-ghost btn-lg" data-i18n="cta_services">Ver servicios</a>
        </div>
        <div class="hero-chips">
          <span class="chip">Software Development</span>
          <span class="chip">UI/UX Design</span>
          <span class="chip">API Integration</span>
          <span class="chip">DevOps</span>
          <span class="chip">Cyber Security</span>
          <span class="chip">Cloud Architecture</span>
        </div>
      </div>
      <div class="hero-canvas-wrap">
        <canvas data-constellation></canvas>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES GRID ============ -->
  <section class="section" id="servicios">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow" data-i18n="svc_eyebrow">Qué hacemos</span>
        <h2 class="section-h" data-i18n="svc_title">Servicios que cubren todo el ciclo de tu producto.</h2>
        <p class="lede" data-i18n="svc_lede">Desde la primera línea de código hasta la operación en producción, te acompañamos en cada etapa.</p>
      </div>
      <div class="svc-grid">
        <a href="/servicios" class="svc-card reveal">
          <span class="svc-num">01</span>
          <div class="svc-icon">
            <svg viewBox="0 0 24 24"><path d="M8 7l-5 5 5 5"/><path d="M16 7l5 5-5 5"/><path d="M13 4l-2 16"/></svg>
          </div>
          <h3 data-i18n="svc1_t">Desarrollo de Software</h3>
          <p data-i18n="svc1_d">Aplicaciones web y móviles a la medida, robustas y escalables, construidas con tecnología moderna.</p>
          <span class="svc-more"><span data-i18n="svc_more">Conocer más</span> →</span>
        </a>
        <a href="/servicios" class="svc-card reveal">
          <span class="svc-num">02</span>
          <div class="svc-icon">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/><path d="M9 9v11"/></svg>
          </div>
          <h3 data-i18n="svc2_t">Diseño UI/UX</h3>
          <p data-i18n="svc2_d">Interfaces claras y centradas en el usuario que convierten, desde la investigación hasta el prototipo final.</p>
          <span class="svc-more"><span data-i18n="svc_more">Conocer más</span> →</span>
        </a>
        <a href="/servicios" class="svc-card reveal">
          <span class="svc-num">03</span>
          <div class="svc-icon">
            <svg viewBox="0 0 24 24"><circle cx="5" cy="6" r="2.2"/><circle cx="19" cy="9" r="2.2"/><circle cx="11" cy="18" r="2.2"/><path d="M6.8 7.2 17.2 8M6.4 7.8 9.6 16M17.6 10.6 12.4 16.4"/></svg>
          </div>
          <h3 data-i18n="svc3_t">Integración de APIs y Sistemas</h3>
          <p data-i18n="svc3_d">Conectamos tus plataformas, servicios y datos en un ecosistema que funciona como uno solo.</p>
          <span class="svc-more"><span data-i18n="svc_more">Conocer más</span> →</span>
        </a>
        <a href="/servicios" class="svc-card reveal">
          <span class="svc-num">04</span>
          <div class="svc-icon">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3.5"/><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3"/></svg>
          </div>
          <h3 data-i18n="svc4_t">Servicios de Consultoría</h3>
          <p data-i18n="svc4_d">Especialistas que elevan el estándar técnico de tu equipo en arquitectura, seguridad, DevOps y más.</p>
          <span class="svc-more"><span data-i18n="svc_more">Conocer más</span> →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ CONSULTING SPECIALTIES ============ -->
  <section class="section alt" id="especialidades">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow" data-i18n="spec_eyebrow">Consultoría especializada</span>
        <h2 class="section-h" data-i18n="spec_title">Ocho disciplinas para fortalecer tu operación técnica.</h2>
        <p class="lede" data-i18n="spec_lede">Extiende tu equipo con expertos donde más lo necesitas — por proyecto o de forma continua.</p>
      </div>
      <div class="spec-grid reveal">
        <div class="spec"><span class="sn">01</span><h4 data-i18n="sp1_t">Arquitectura</h4><p data-i18n="sp1_d">Diseño de sistemas escalables, resilientes y mantenibles.</p></div>
        <div class="spec"><span class="sn">02</span><h4 data-i18n="sp2_t">Automatización</h4><p data-i18n="sp2_d">CI/CD, IaC y flujos que eliminan el trabajo manual.</p></div>
        <div class="spec"><span class="sn">03</span><h4 data-i18n="sp3_t">Revisión de Código</h4><p data-i18n="sp3_d">Evaluación experta para elevar calidad y consistencia.</p></div>
        <div class="spec"><span class="sn">04</span><h4 data-i18n="sp4_t">Ciberseguridad</h4><p data-i18n="sp4_d">Auditorías, buenas prácticas y protección de datos.</p></div>
        <div class="spec"><span class="sn">05</span><h4 data-i18n="sp5_t">Bases de Datos</h4><p data-i18n="sp5_d">Modelado, optimización y alta disponibilidad.</p></div>
        <div class="spec"><span class="sn">06</span><h4 data-i18n="sp6_t">DevOps</h4><p data-i18n="sp6_d">Entrega continua y operación confiable en la nube.</p></div>
        <div class="spec"><span class="sn">07</span><h4 data-i18n="sp7_t">Observabilidad</h4><p data-i18n="sp7_d">Métricas, logs y trazas para ver todo tu sistema.</p></div>
        <div class="spec"><span class="sn">08</span><h4 data-i18n="sp8_t">Rendimiento</h4><p data-i18n="sp8_d">Diagnóstico y tuning para sistemas rápidos y eficientes.</p></div>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="section" style="padding-top:0;padding-bottom:0;transform:translateY(-55px)">
    <div class="wrap">
      <div class="stats reveal">
        <div class="stat"><div class="num">4</div><div class="lab" data-i18n="stat1_l">Servicios principales</div></div>
        <div class="stat"><div class="num">8</div><div class="lab" data-i18n="stat2_l">Especialidades de consultoría</div></div>
        <div class="stat"><div class="num"><em>ES / EN</em></div><div class="lab" data-i18n="stat3_l">Equipo bilingüe</div></div>
        <div class="stat"><div class="num">100<em>%</em></div><div class="lab" data-i18n="stat4_l">Enfocados en tu éxito</div></div>
      </div>
    </div>
  </section>

  <!-- ============ WHY US / VALUES ============ -->
  <section class="section" id="nosotros">
    <div class="wrap split">
      <div class="section-head reveal" style="margin-bottom:0">
        <span class="eyebrow" data-i18n="why_eyebrow">Por qué Constelutions</span>
        <h2 class="section-h" data-i18n="why_title">Un socio técnico en quien puedes confiar.</h2>
        <p class="lede" data-i18n="why_lede">No solo entregamos software: construimos relaciones de largo plazo basadas en transparencia y resultados.</p>
      </div>
      <div class="values reveal">
        <div class="value">
          <div class="vi"><svg viewBox="0 0 24 24"><path d="M12 3l2 7 7 2-7 2-2 7-2-7-7-2 7-2z"/></svg></div>
          <div><h4 data-i18n="val1_t">Equipo senior</h4><p data-i18n="val1_d">Ingenieros y diseñadores con experiencia real en producción.</p></div>
        </div>
        <div class="value">
          <div class="vi"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg></div>
          <div><h4 data-i18n="val2_t">Bilingüe ES / EN</h4><p data-i18n="val2_d">Comunicación fluida con clientes en México, LATAM y EE. UU.</p></div>
        </div>
        <div class="value">
          <div class="vi"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg></div>
          <div><h4 data-i18n="val3_t">Rigor de ingeniería</h4><p data-i18n="val3_d">Pruebas, revisión de código y estándares en cada entrega.</p></div>
        </div>
        <div class="value">
          <div class="vi"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><ellipse cx="12" cy="12" rx="9.5" ry="4.2"/></svg></div>
          <div><h4 data-i18n="val4_t">Visión de largo plazo</h4><p data-i18n="val4_d">Soluciones mantenibles que crecen junto con tu negocio.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="section alt" id="proceso">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow" data-i18n="proc_eyebrow">Cómo trabajamos</span>
        <h2 class="section-h" data-i18n="proc_title">Un proceso claro, de la idea a producción.</h2>
        <p class="lede" data-i18n="proc_lede">Metodología ágil con entregas continuas y visibilidad total en cada paso.</p>
      </div>
      <div class="process">
        <div class="step reveal"><div class="pnum">01</div><h4 data-i18n="st1_t">Descubrimiento</h4><p data-i18n="st1_d">Entendemos tu negocio, objetivos y requisitos técnicos.</p></div>
        <div class="step reveal"><div class="pnum">02</div><h4 data-i18n="st2_t">Diseño</h4><p data-i18n="st2_d">Definimos arquitectura y experiencia antes de escribir código.</p></div>
        <div class="step reveal"><div class="pnum">03</div><h4 data-i18n="st3_t">Desarrollo</h4><p data-i18n="st3_d">Construimos en ciclos cortos con demos frecuentes.</p></div>
        <div class="step reveal"><div class="pnum">04</div><h4 data-i18n="st4_t">Integración</h4><p data-i18n="st4_d">Conectamos sistemas y aseguramos calidad con pruebas.</p></div>
        <div class="step reveal"><div class="pnum">05</div><h4 data-i18n="st5_t">Lanzamiento</h4><p data-i18n="st5_d">Desplegamos con confianza y pipelines automatizados.</p></div>
        <div class="step reveal"><div class="pnum">06</div><h4 data-i18n="st6_t">Soporte</h4><p data-i18n="st6_d">Monitoreo, mejoras y acompañamiento continuo.</p></div>
      </div>
    </div>
  </section>

  <!-- ============ TECH STACK ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow" data-i18n="tech_eyebrow">Stack tecnológico</span>
        <h2 class="section-h" data-i18n="tech_title">Herramientas modernas, elegidas con criterio.</h2>
        <p class="lede" data-i18n="tech_lede">Seleccionamos cada tecnología según las necesidades del proyecto, no por moda.</p>
      </div>
      <div class="tech-cols reveal">
        <div class="tech-col">
          <h4 data-i18n="tech_c1">Frontend</h4>
          <ul><li>React</li><li>Next.js</li><li>TypeScript</li><li>Vue</li><li>Tailwind CSS</li></ul>
        </div>
        <div class="tech-col">
          <h4 data-i18n="tech_c2">Backend</h4>
          <ul><li>Node.js</li><li>Python</li><li>Go</li><li>.NET</li><li>PostgreSQL</li></ul>
        </div>
        <div class="tech-col">
          <h4 data-i18n="tech_c3">Nube &amp; DevOps</h4>
          <ul><li>AWS</li><li>Azure</li><li>Docker</li><li>Kubernetes</li><li>Terraform</li></ul>
        </div>
        <div class="tech-col">
          <h4 data-i18n="tech_c4">Datos &amp; Móvil</h4>
          <ul><li>React Native</li><li>Flutter</li><li>GraphQL</li><li>Redis</li><li>MongoDB</li></ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="section alt">
    <div class="wrap">
      <div class="section-head center reveal">
        <span class="eyebrow center" data-i18n="test_eyebrow">Lo que dicen</span>
        <h2 class="section-h" style="margin-left:auto;margin-right:auto" data-i18n="test_title">Confianza que se construye proyecto a proyecto.</h2>
      </div>
      <div class="quotes">
        <div class="quote reveal">
          <div class="mark">"</div>
          <p data-i18n="q1">Constelutions entendió nuestra operación desde el primer día y entregó una plataforma que nuestro equipo realmente usa.</p>
          <div class="who"><div class="av"></div><div><div class="nm" data-i18n="q1_n">Nombre Apellido</div><div class="rl" data-i18n="q1_r">Dirección de Operaciones</div></div></div>
        </div>
        <div class="quote reveal">
          <div class="mark">"</div>
          <p data-i18n="q2">El nivel técnico y la comunicación fueron excepcionales. Se sintieron como parte de nuestro equipo.</p>
          <div class="who"><div class="av"></div><div><div class="nm" data-i18n="q2_n">Nombre Apellido</div><div class="rl" data-i18n="q2_r">CTO, Empresa de Tecnología</div></div></div>
        </div>
        <div class="quote reveal">
          <div class="mark">"</div>
          <p data-i18n="q3">Modernizamos sistemas críticos sin interrumpir la operación. Resultados claros y medibles.</p>
          <div class="who"><div class="av"></div><div><div class="nm" data-i18n="q3_n">Nombre Apellido</div><div class="rl" data-i18n="q3_r">Gerente de TI</div></div></div>
        </div>
      </div>
      <p class="placeholder-note" data-i18n="test_note">Testimonios de ejemplo — reemplázalos con reseñas reales de tus clientes.</p>
    </div>
  </section>

  <!-- ============ TEAM ============ -->
  <section class="section" id="equipo">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow" data-i18n="team_eyebrow">Nuestro equipo</span>
        <h2 class="section-h" data-i18n="team_title">Las personas detrás de cada solución.</h2>
        <p class="lede" data-i18n="team_lede">Un grupo multidisciplinario de ingenieros, diseñadores y consultores.</p>
      </div>
      <div class="team">
        <div class="member reveal"><div class="photo"><span data-i18n="team_photo">Foto</span></div><div class="info"><div class="nm" data-i18n="team_name">Nombre Apellido</div><div class="rl" data-i18n="m1_r">Desarrollo de Software</div></div></div>
        <div class="member reveal"><div class="photo"><span data-i18n="team_photo">Foto</span></div><div class="info"><div class="nm" data-i18n="team_name">Nombre Apellido</div><div class="rl" data-i18n="m2_r">Diseño UI/UX</div></div></div>
        <div class="member reveal"><div class="photo"><span data-i18n="team_photo">Foto</span></div><div class="info"><div class="nm" data-i18n="team_name">Nombre Apellido</div><div class="rl" data-i18n="m3_r">Arquitectura &amp; DevOps</div></div></div>
        <div class="member reveal"><div class="photo"><span data-i18n="team_photo">Foto</span></div><div class="info"><div class="nm" data-i18n="team_name">Nombre Apellido</div><div class="rl" data-i18n="m4_r">Consultoría &amp; Estrategia</div></div></div>
      </div>
      <p class="placeholder-note" data-i18n="team_note">Fotos y nombres de ejemplo — añade a tu equipo real.</p>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="section alt" id="contacto">
    <div class="wrap contact-grid">
      <div class="contact-info reveal">
        <span class="eyebrow" data-i18n="contact_eyebrow">Contacto</span>
        <h2 class="section-h" style="margin-top:18px" data-i18n="contact_title">Cuéntanos sobre tu proyecto.</h2>
        <p class="lede" style="margin-top:20px" data-i18n="contact_lede">Responderemos en menos de 24 horas hábiles. Sin compromisos.</p>
        <div class="ci"><div class="k" data-i18n="ci_email_k">Correo</div><div class="v"><a href="mailto:hola@constelutions.com">hola@constelutions.com</a></div></div>
        <div class="ci"><div class="k" data-i18n="ci_phone_k">Teléfono</div><div class="v"><a href="tel:+520000000000">+52 000 000 0000</a></div></div>
        <div class="ci"><div class="k" data-i18n="ci_loc_k">Ubicación</div><div class="v" data-i18n="ci_loc_v">México</div></div>
        <div class="ci"><div class="k" data-i18n="ci_hours_k">Horario</div><div class="v" data-i18n="ci_hours_v">Lun–Vie · 9:00–18:00 (CST)</div></div>
      </div>
      <form class="card reveal" novalidate>
        <div class="form-fields">
          <div class="field row">
            <div><label data-i18n="f_name">Nombre</label><input type="text" name="name" required data-i18n-attr="placeholder:f_name_ph" placeholder="Tu nombre" /></div>
            <div><label data-i18n="f_email">Correo</label><input type="email" name="email" required data-i18n-attr="placeholder:f_email_ph" placeholder="tu@empresa.com" /></div>
          </div>
          <div class="field"><label data-i18n="f_company">Empresa</label><input type="text" name="company" data-i18n-attr="placeholder:f_company_ph" placeholder="Nombre de tu empresa" /></div>
          <div class="field">
            <label data-i18n="f_service">Servicio de interés</label>
            <select name="service">
              <option value="" data-i18n="opt_default">Selecciona una opción</option>
              <option value="dev" data-i18n="opt_dev">Desarrollo de Software</option>
              <option value="design" data-i18n="opt_design">Diseño UI/UX</option>
              <option value="integration" data-i18n="opt_integration">Integración de APIs y Sistemas</option>
              <option value="consulting" data-i18n="opt_consulting">Consultoría</option>
              <option value="other" data-i18n="opt_other">Otro</option>
            </select>
          </div>
          <div class="field"><label data-i18n="f_message">Mensaje</label><textarea name="message" required data-i18n-attr="placeholder:f_message_ph" placeholder="Cuéntanos qué necesitas…"></textarea></div>
          <button type="submit" class="btn btn-primary btn-lg" style="width:100%;justify-content:center" data-i18n="f_submit">Enviar mensaje</button>
        </div>
        <div class="form-success">
          <div class="check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></div>
          <h3 style="font-size:22px;margin-bottom:10px" data-i18n="f_success_t">¡Gracias! Hemos recibido tu mensaje.</h3>
          <p class="muted" data-i18n="f_success_d">Te contactaremos muy pronto.</p>
        </div>
      </form>
    </div>
  </section>

  <!-- ============ CTA BANNER ============ -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="cta-banner reveal">
        <div class="glow"></div>
        <div class="starfield" data-stars="30"></div>
        <h2 data-i18n="cta_title">¿Listo para construir algo extraordinario?</h2>
        <p class="lede" data-i18n="cta_lede">Agenda una consulta gratuita y descubre cómo podemos ayudarte.</p>
        <div class="hero-cta">
          <a href="#contacto" class="btn btn-primary btn-lg" data-i18n="cta_book">Agenda una consulta</a>
          <a href="/servicios" class="btn btn-ghost btn-lg" data-i18n="cta_services">Ver servicios</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
