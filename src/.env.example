# Copy this file to `.env` in this same directory, then fill in the value(s)
# marked REQUIRED below:
#
#   cp .env.example .env
#
# `docker compose` loads `.env` from the directory holding docker-compose.yml,
# which is this one — a .env placed anywhere else is silently ignored.
#
# `.env` is git-ignored. Never commit a real key. In production these are set
# in Coolify's environment UI instead of in a file.


# ---------------------------------------------------------------------------
# REQUIRED — you must fill this in
# ---------------------------------------------------------------------------

# Resend API key. Create one at https://resend.com/api-keys with "Sending
# access". Compose refuses to start without it:
#   required variable RESEND_API_KEY is missing a value
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cap (self-hosted captcha) admin dashboard login. Make it 32+ characters.
# See specs/contact-form-anti-spam.md for the dashboard-access workflow
# (SSH tunnel only — it is never exposed publicly) and the first-deploy
# bootstrap that mints a site key.
CAP_ADMIN_KEY=change-me-to-a-32-plus-char-secret

# The Cap site key created in the dashboard. Baked into the built site at
# image-build time (it is public by nature — the widget sends it to the
# browser regardless). Compose refuses to start without it, same as
# RESEND_API_KEY above.
PUBLIC_CAP_SITE_KEY=


# ---------------------------------------------------------------------------
# OPTIONAL — every one of these already has a working default in
# docker-compose.yml. Uncomment only to override.
# ---------------------------------------------------------------------------

# Sender address. Must sit on a domain verified in Resend: constelutions.tech
# is verified, constelutions.com is NOT. Resend rejects anything else.
# CONTACT_FROM=Constelutions <no-reply@constelutions.tech>

# Where submissions are delivered.
# CONTACT_TO=theconstelutions@gmail.com

# For local testing, point it at a Resend simulator address instead so the
# real inbox is left alone. The +label is free-form and useful for tracing.
# See https://resend.com/docs/dashboard/emails/send-test-emails
# CONTACT_TO=delivered+contact-form@resend.dev

# Cap's siteverify endpoint, e.g. http://cap:3000/<site_key>/siteverify.
# UNSET means captcha enforcement is OFF — every submission is accepted
# regardless of its token. Leave unset for local dev; set it only once the
# first-deploy bootstrap (specs/contact-form-anti-spam.md) has minted a
# site key and its secret.
# CAP_SITEVERIFY_URL=http://cap:3000/<site_key>/siteverify

# The site key's secret (NOT CAP_ADMIN_KEY). Required iff CAP_SITEVERIFY_URL
# is set.
# CAP_SECRET_KEY=

# Global cap on verified sends per hour, across all clients — protects the
# Resend quota from distributed spam that per-IP rate limiting cannot see.
# 4/h = worst case 96/day, under Resend's free 100/day.
# MAX_SENDS_PER_HOUR=4

# Restricts which browser origins may embed this site's Cap widget. Cap
# defaults to "*" (any origin) when unset. The real contact form always
# reaches Cap same-origin through nginx's /cap/ proxy, so this does not gate
# the legitimate flow either way — it only stops a third-party page from
# embedding the widget to farm valid tokens in visitors' browsers. It does
# NOT stop a script calling Cap's endpoints directly (CORS is
# browser-enforced only). Comma-separated for multiple domains, no scheme:
# CAP_CORS_ORIGIN=constelutions.tech


# ---------------------------------------------------------------------------
# Note: PORT is NOT read from here.
#
# docker-compose.yml pins the mailer to PORT: "8080" because nginx.conf proxies
# to that exact port; letting the two drift apart would break the contact form.
# It is only worth setting when running the service directly, outside Docker:
#
#   cd mailer
#   RESEND_API_KEY=re_xxx PORT=9000 dart run bin/server.dart
# ---------------------------------------------------------------------------
