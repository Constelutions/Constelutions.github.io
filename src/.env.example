# Copy this file to `.env` in this same directory, then fill in the value
# marked REQUIRED below:
#
#   cp .env.example .env
#
# `docker compose` loads `.env` from the directory holding docker-compose.yml,
# which is this one — a .env placed anywhere else is silently ignored.
#
# `.env` is git-ignored. In production the value is set in Coolify's
# environment UI instead of in a file.


# ---------------------------------------------------------------------------
# REQUIRED — you must fill this in
# ---------------------------------------------------------------------------

# Site key on the shared Cap instance (https://captcha.constelutions.tech,
# run from the infra repo, ADR 0004). Created in that instance's dashboard.
# Baked into the built site at image-build time (it is public by nature — the
# widget sends it to the browser regardless). Compose refuses to start without
# it:
#   required variable PUBLIC_CAP_SITE_KEY is missing a value
PUBLIC_CAP_SITE_KEY=
