---
import { getProjects } from "../repositories/projectsRepository";
import LiveBadge from "./LiveBadge.astro";
import ProductLink from "./ProductLink.astro";

const projects = (await getProjects()).slice(0, 4);
---

<section
  class="section"
  id="portfolio">
  <div class="wrap">
    <div class="section-head reveal">
      <span
        class="eyebrow"
        data-i18n="ps_eyebrow"
        >Proyectos destacados</span
      >
      <h2
        class="section-h"
        data-i18n="ps_title">
        Sistemas que hemos construido
      </h2>
      <p
        class="lede"
        data-i18n="ps_lede">
        Nuestros productos en vivo y los sistemas que hemos construido para clientes de fintech y
        salud.
      </p>
    </div>
    <div class="ps-grid">
      {
        projects.map((p) => (
          <div class="ps-card reveal">
            <div class="ps-card-head">
              <div class="ps-badges">
                <span
                  class="industry-badge"
                  data-i18n={p.industry_i18n}>
                  {p.industry}
                </span>
                {p.live && <LiveBadge />}
              </div>
              <span class="ps-num">{p.num}</span>
            </div>
            <h3 data-i18n={p.title_i18n}>{p.title}</h3>
            <div class="ps-outcome">
              <svg viewBox="0 0 24 24">
                <path d={p.live ? "M5 13l4 4L19 7" : "M3 17l4-8 4 4 4-6 4 9"} />
              </svg>
              <span data-i18n={p.outcome_i18n}>{p.outcome}</span>
            </div>
            <div class="ps-tags">
              {p.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            {p.live && (
              <ProductLink
                url={p.live.url}
                label={p.live.cta}
                labelKey={p.live.cta_i18n}
              />
            )}
          </div>
        ))
      }
    </div>
    <div class="ps-footer reveal">
      <a
        href="/portfolio/"
        class="btn btn-ghost"
        data-i18n="ps_cta"
        >Ver portafolio</a
      >
    </div>
  </div>
</section>

<style>
  .ps-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .ps-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: border-color 0.2s;
  }
  .ps-card:hover {
    border-color: var(--accent);
  }
  .ps-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .ps-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .industry-badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-ink);
    border: 1px solid oklch(0.5 0.16 266 / 0.4);
    border-radius: 999px;
    padding: 4px 12px;
  }
  .ps-num {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
    letter-spacing: 0.08em;
  }
  .ps-card h3 {
    font-size: 19px;
    line-height: 1.25;
    margin: 0;
  }
  .ps-outcome {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 12px 16px;
    background: oklch(0.28 0.06 266 / 0.25);
    border: 1px solid oklch(0.4 0.1 266 / 0.4);
    border-radius: var(--radius-sm);
  }
  .ps-outcome svg {
    width: 16px;
    height: 16px;
    stroke: var(--ok);
    fill: none;
    stroke-width: 2;
    flex: 0 0 auto;
    margin-top: 2px;
  }
  .ps-outcome span {
    font-size: 13.5px;
    color: var(--ok);
    font-weight: 500;
    line-height: 1.4;
  }
  .ps-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: auto;
  }
  .tag {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent-2);
    background: oklch(0.28 0.06 266 / 0.45);
    border: 1px solid oklch(0.4 0.08 266 / 0.5);
    border-radius: 6px;
    padding: 3px 9px;
    letter-spacing: 0.03em;
  }
  .ps-footer {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  @media (max-width: 860px) {
    .ps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
