---
import { getContact } from "../repositories/companyRepository";
import Logo from "./Logo.astro";

const contact = await getContact();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a
          class="brand"
          href="/">
          <Logo />
          <span class="wm">Conste<b>lutions</b></span>
        </a>
        <p data-i18n="foot_tagline">
          Constelaciones de talento para resolver tus retos de software. Desde México para el mundo.
        </p>
        <div class="foot-soc">
          <a
            href={contact.linkedin}
            aria-label="LinkedIn"
            target="_blank"
            rel="noopener noreferrer">
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path
                d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21H17.6v-5.3c0-1.26-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H9z"
              ></path></svg
            >
          </a>
          <a
            href={contact.github}
            aria-label="GitHub"
            target="_blank"
            rel="noopener noreferrer">
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path
                d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.36-3.37-1.36-.46-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1.01.07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.85.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.59.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"
              ></path></svg
            >
          </a>
        </div>
      </div>
      <div class="foot-col">
        <h2 data-i18n="foot_services">Servicios</h2>
        <ul>
          <li>
            <a
              href="/services/"
              data-i18n="svc1_t"
              >Desarrollo de Software</a
            >
          </li>
          <li>
            <a
              href="/services/"
              data-i18n="svc2_t"
              >Diseño UI/UX</a
            >
          </li>
          <li>
            <a
              href="/services/"
              data-i18n="svc3_t"
              >Integración de APIs</a
            >
          </li>
          <li>
            <a
              href="/services/"
              data-i18n="svc4_t"
              >Consultoría</a
            >
          </li>
        </ul>
      </div>
      <div class="foot-col">
        <h2 data-i18n="foot_company">Empresa</h2>
        <ul>
          <li>
            <a
              href="/"
              data-i18n="nav_home"
              >Inicio</a
            >
          </li>
          <li>
            <a
              href="/portfolio/"
              data-i18n="nav_portfolio"
              >Portafolio</a
            >
          </li>
          <li>
            <a
              href="/about/"
              data-i18n="nav_about"
              >Nosotros</a
            >
          </li>
          <li>
            <a
              href="/#process"
              data-i18n="nav_process"
              >Proceso</a
            >
          </li>
        </ul>
      </div>
      <div class="foot-col">
        <h2 data-i18n="foot_contact">Contacto</h2>
        <ul>
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li>
            <a
              href="/#contact"
              data-i18n="cta_talk"
              >Hablemos</a
            >
          </li>
          <li class="foot-location">
            <span data-i18n="ci_loc_k">Ubicación</span>: <span data-i18n={contact.location_i18n}
              >{contact.location}</span
            >
          </li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <p>
        © 2026 Constelutions. <span data-i18n="foot_rights">Todos los derechos reservados.</span>
      </p>
      <p data-i18n="foot_made">Hecho en México</p>
    </div>
  </div>
</footer>
