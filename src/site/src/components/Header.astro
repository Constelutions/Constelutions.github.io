---
import ThemeToggle from "./ThemeToggle.astro";
import LangToggle from "./LangToggle.astro";
import LogoLong from "./LogoLong.astro";

interface Props {
  activePage?: string;
}

const { activePage = "home" } = Astro.props;

const pages: { href: string; pageId: string; "data-i18n": string; label: string }[] = [
  {
    href: "/",
    pageId: "home",
    "data-i18n": "nav_home",
    label: "Inicio",
  },
  {
    href: "/services/",
    pageId: "services",
    "data-i18n": "nav_services",
    label: "Servicios",
  },
  {
    href: "/portfolio/",
    pageId: "portfolio",
    "data-i18n": "nav_portfolio",
    label: "Portafolio",
  },
  {
    href: "/about/",
    pageId: "about",
    "data-i18n": "nav_about",
    label: "Nosotros",
  },
] as const;
---

<header class="site-header">
  <div class="wrap nav">
    <a
      class="brand"
      href="/"
      aria-label="Constelutions — inicio">
      <LogoLong />
    </a>
    <nav
      class="nav-links"
      aria-label="Principal">
      {
        pages.map((page) => (
          <a
            href={page.href}
            class={activePage === page.pageId ? "active" : ""}
            data-i18n={page["data-i18n"]}>
            {page.label}
          </a>
        ))
      }
      <a
        href="/#contact"
        class="btn btn-primary nav-cta-mobile"
        data-i18n="cta_book"
        >Agenda una consulta</a
      >
    </nav>

    <div class="nav-right">
      <ThemeToggle />
      <LangToggle />
      <a
        href="/#contact"
        class="btn btn-primary nav-cta"
        data-i18n="cta_book"
        >Agenda una consulta</a
      >
      <button
        class="nav-toggle"
        aria-label="Menú"
        type="button">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          ><path d="M4 7h16M4 12h16M4 17h16"></path></svg
        >
      </button>
    </div>
  </div>
</header>

<style>
  .nav-cta-mobile {
    display: none;
  }

  @media (max-width: 860px) {
    .nav-cta {
      display: none;
    }
    .nav-cta-mobile {
      display: inline-flex;
      margin-top: 10px;
      align-self: flex-start;
    }
  }
</style>
