---

<section class="hero">
  <div
    class="starfield"
    data-stars="60">
  </div>
  <div class="wrap hero-grid">
    <div class="hero-left">
      <span
        class="eyebrow"
        data-i18n="hero_eyebrow"
        >Software a la medida</span
      >
      <h1 data-i18n-html="hero_head">Construimos el software que <em>impulsa</em> tu negocio</h1>
      <p
        class="lede"
        data-i18n="hero_lede">
        Conectamos ingeniería, diseño y estrategia para construir productos digitales que se alinean
        a tus objetivos.
      </p>
      <div class="hero-cta">
        <a
          href="#contact"
          class="btn btn-primary btn-lg"
          data-i18n="cta_start"
          >Iniciar proyecto</a
        >
        <a
          href="/services/"
          class="btn btn-ghost btn-lg"
          data-i18n="cta_services"
          >Ver servicios</a
        >
      </div>
      <div class="hero-chips">
        <span
          class="chip"
          data-i18n="chip_dev"
          >Desarrollo de Software</span
        >
        <span
          class="chip"
          data-i18n="chip_design"
          >Diseño UI/UX</span
        >
        <span
          class="chip"
          data-i18n="chip_api"
          >Integración de APIs</span
        >
        <span
          class="chip"
          data-i18n="chip_devops"
          >DevOps</span
        >
        <span
          class="chip"
          data-i18n="chip_security"
          >Ciberseguridad</span
        >
        <span
          class="chip"
          data-i18n="chip_cloud"
          >Arquitectura Cloud</span
        >
      </div>
    </div>
    <div class="hero-canvas-wrap">
      <canvas data-constellation></canvas>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 76px;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-grid {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 40px;
    align-items: center;
    min-height: calc(100vh - 76px);
    padding: 40px 0 60px;
  }
  .hero h1 {
    font-size: clamp(40px, 5.4vw, 70px);
    margin: 24px 0 26px;
  }
  .hero .lede {
    max-width: 500px;
  }
  .hero-cta {
    display: flex;
    gap: 14px;
    margin-top: 38px;
    flex-wrap: wrap;
  }
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 46px;
    max-width: 540px;
  }
  .chip {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 13px;
    background: oklch(0.2 0.03 264 / 0.4);
  }
  .hero-canvas-wrap {
    position: relative;
    height: 100%;
    min-height: 520px;
  }
  /* The canvas is positioned (not width/height:100%) so its own drawing-buffer
     size can never feed back into hero-canvas-wrap's layout height: a
     percentage height on an in-flow replaced element can fall back to the
     element's intrinsic width/height attributes when the ancestor chain is
     indefinite, and scripts/main.ts's resize() writes those very attributes -
     that created a live ResizeObserver feedback loop at fractional
     devicePixelRatio (e.g. 110% Windows display scaling): the canvas grew a
     little every tick, which grew the wrap, which re-fired the observer,
     forever. Inset-based sizing resolves purely against the containing
     block's already-settled box, so the canvas can no longer influence it. */
  .hero-canvas-wrap canvas {
    position: absolute;
    inset: 0;
    display: block;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: calc(100vh - 76px);
      padding-top: 48px;
      padding-bottom: 64px;
      position: relative;
    }
    /* Canvas becomes a full-bleed background behind the text.
       .hero already has position:relative + isolation:isolate + overflow:hidden,
       so the canvas fills it edge-to-edge regardless of the wrap padding. */
    .hero-canvas-wrap {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100vw;
      height: 100%;
      min-height: unset;
      order: unset;
      opacity: 0.4;
      pointer-events: none;
      z-index: 1;
    }
    /* Text column fills full width, sits on top of the canvas */
    .hero-left {
      position: relative;
      z-index: 2;
    }
    .hero h1 {
      font-size: clamp(34px, 9vw, 54px);
    }
    .hero .lede {
      max-width: 100%;
    }
    .hero-chips {
      margin-top: 32px;
    }
  }
  @media (max-width: 480px) {
    .hero-grid {
      padding-top: 40px;
      padding-bottom: 56px;
      padding-left: 24px;
      padding-right: 24px;
    }
    .hero-cta {
      flex-direction: column;
      gap: 10px;
    }
    .hero-cta .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
