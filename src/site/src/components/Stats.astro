---
import { getStats } from "../repositories/statsRepository";

const stats = await getStats();
---

<section
  class="section stats-section"
  style="padding-top:0;padding-bottom:0;transform:translateY(-55px)">
  <div class="wrap">
    <div class="stats reveal">
      {
        stats.map((s) => (
          <div class="stat">
            <div class="num">
              {s.suffix === true ? (
                <em>{s.value}</em>
              ) : typeof s.suffix === "string" ? (
                <>
                  {s.value}
                  <em>{s.suffix}</em>
                </>
              ) : (
                s.value
              )}
            </div>
            <div
              class="lab"
              data-i18n={s.label_i18n}>
              {s.label}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .stat {
    background: var(--bg);
    padding: 40px 30px;
    text-align: center;
  }
  :global(.section.alt) .stat {
    background: var(--bg-2);
  }
  .stat .num {
    font-family: var(--display);
    font-size: clamp(34px, 4vw, 48px);
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .stat .num em {
    font-style: normal;
    color: var(--accent-2);
  }
  .stat .lab {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    margin-top: 10px;
  }

  @media (max-width: 1040px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
    :global(.stats-section) {
      transform: none !important;
      padding-top: 0 !important;
      padding-bottom: 60px !important;
    }
  }
</style>
