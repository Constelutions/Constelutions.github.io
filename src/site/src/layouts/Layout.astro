---
import { Font } from "astro:assets";
import CtaBanner from "../components/CtaBanner.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description?: string;
  activePage?: string;
}

const {
  title,
  description = "Constelutions — Desarrollo de software, diseño UI/UX, integración de sistemas y consultoría técnica. Desde México para el mundo.",
  activePage = "home",
} = Astro.props;
---

<!doctype html>
<html
  lang="es"
  data-lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />
    {/* sizes="any" on the .ico keeps browsers that support SVG icons from
         preferring it, so the theme-aware favicon.svg wins where available. */}
    <link
      rel="icon"
      href="/favicon.ico"
      sizes="any"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    {/* Self-hosted via Astro's Fonts API (astro.config.mjs): fetched from
         Google at build time, served from our own origin, and paired with an
         auto-generated metric-matched fallback so the swap doesn't reflow. */}
    <Font
      cssVariable="--font-space-grotesk"
      preload
    />
    <Font
      cssVariable="--font-ibm-plex-sans"
      preload
    />
    <Font cssVariable="--font-ibm-plex-mono" />
    {/*
      The only two things that must run before first paint, so they stay
      inline (Astro emits is:inline verbatim, bypassing Vite - it is neither
      bundled nor minified, which is why this is written compactly and kept
      as small as it can be):
        1. theme init - reads the stored theme and stamps data-theme on <html>
           before the first paint, so there is no flash of the wrong theme.
        2. scrollRestoration = "manual" - has to be set before the browser
           restores the previous scroll offset on a refresh, which would
           otherwise land the user somewhere past the hero.
      Everything else is deferred into the bundled, minified module below.
    */}
    <script is:inline>
      (function (d) {
        // Guarded: reading localStorage throws outright when the browser
        // blocks storage for the origin, and an uncaught throw here would
        // take the scroll fix below down with it.
        var t;
        try {
          t = localStorage.getItem("cl_theme");
        } catch (e) {}
        d.documentElement.setAttribute("data-theme", t === "light" ? t : "dark");
        if (history.scrollRestoration) history.scrollRestoration = "manual";
        addEventListener("load", function () {
          var h = location.hash && d.querySelector(location.hash);
          h ? h.scrollIntoView() : scrollTo(0, 0);
        });
      })(document);
    </script>
  </head>
  <body>
    <Header activePage={activePage} />

    {/* Every page needs exactly one <main>: it is the landmark screen-reader
         users jump to in order to skip the header/nav. The CTA banner and
         footer stay outside it - they are site-wide furniture, not this
         page's primary content. */}
    <main id="main">
      <slot />
    </main>

    {
      activePage !== "home" && (
        <CtaBanner>
          <a
            href="/#contact"
            class="btn btn-primary btn-lg"
            data-i18n="cta_book">
            Agenda una consulta
          </a>
          <a
            href="/services/"
            class="btn btn-ghost btn-lg"
            data-i18n="cta_services">
            Ver servicios
          </a>
        </CtaBanner>
      )
    }

    <Footer />

    <script>
      import "../scripts/i18n.ts";
      import "../scripts/main.ts";
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
